<!DOCTYPE html>
<html lang="en">
<%- include('partials/header.ejs') %>

    <body>
        <div class="container">
            <% if (locals.bandName) { %>
                <h1>
                    <%= bandName %>
                </h1>
                <% } else { %>
                    <h1>Welcome to the band name Generator</h1>
                    <% } %>

                        <form action="/generate" method="post">
